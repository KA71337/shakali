# ОБЯЗАТЕЛЬНО: URL локальной PostgreSQL. В Render DATABASE_URL подключается из Blueprint.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anonymous_messages?schema=public"

# ОБЯЗАТЕЛЬНО: три независимых секрета длиной 32+ символа.
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Render Blueprint генерирует их автоматически через generateValue.
IP_HASH_SECRET="replace-with-a-random-secret-at-least-32-characters"
FORM_TOKEN_SECRET="replace-with-another-random-secret-at-least-32-characters"
ADMIN_SESSION_SECRET="replace-with-a-third-random-secret-at-least-32-characters"

# ОБЯЗАТЕЛЬНО: придумайте уникальный пароль админки, минимум 12 символов.
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# ОБЯЗАТЕЛЬНО для Telegram-уведомлений; имена точно совпадают с кодом.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# true в production; false разрешает локальный запуск без Telegram.
TELEGRAM_REQUIRED="false"

# ОПЦИОНАЛЬНО: обе переменные Turnstile задаются вместе.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ОПЦИОНАЛЬНО: после deploy укажите https://<service>.onrender.com.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_TIMEZONE="Europe/Moscow"

# Для Render оставьте 1 (один доверенный reverse proxy).
TRUSTED_PROXY_COUNT="1"

# PORT, NODE_ENV и RENDER_EXTERNAL_URL здесь не нужны: Render задаёт их сам.
